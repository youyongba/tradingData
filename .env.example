# ===== Webhook 鉴权 =====
AUTH_TOKEN=change-me-please

# ===== Telegram =====
# 在 @BotFather 创建 Bot 获取 TOKEN；与 Bot 私聊后访问
# https://api.telegram.org/bot<TOKEN>/getUpdates 获取 chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== 服务端口 =====
PORT=8787

# ===== 币安 =====
# 公开行情，无需 API Key。
BINANCE_FUTURES_REST=https://fapi.binance.com
BINANCE_FUTURES_WS=wss://fstream.binance.com

# ===== HTTPS 代理（中国大陆需要） =====
# 同时作用于：币安 REST、币安 WebSocket、Telegram
# 例如本地 Clash/V2ray：
# HTTPS_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=

# ===== REST 兜底轮询间隔（毫秒） =====
# 当 WS 不通（代理对 WSS 转发不稳）时，自动用 REST 拉数据
POLL_INTERVAL_MS=2000
KLINE_POLL_INTERVAL_MS=15000
